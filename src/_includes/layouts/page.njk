---
layout: layouts/base.njk
---
<article class="article">
  <header class="article-header">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
  </header>
  <div class="article-body">
    {{ content | safe }}
  </div>
</article>
