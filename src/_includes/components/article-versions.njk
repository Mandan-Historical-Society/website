{% if editorial.status == "confirmed" %}
  {% include "articles/" + articleVersionKey + "/copy-edited.njk" %}
{% else %}
<section class="article-versions" data-article-versions data-default-view="{{ editorial.defaultView }}">
  <div class="article-version-toolbar">
    <div class="article-version-controls" role="group" aria-label="Article version">
      <button type="button" data-article-view="original" aria-pressed="true">Original</button>
      <button type="button" data-article-view="copy-edited" aria-pressed="false">Copy-edited</button>
      <button type="button" data-article-view="compare" aria-pressed="false">Compare</button>
    </div>
    <p class="article-version-note">{{ editorial.note or "The copy-edited text corrects grammar, spelling, punctuation, and clarity without intentional factual changes." }}</p>
  </div>

  <div data-article-panel="original">
    <h2 class="visually-hidden">Original article</h2>
    {% include "articles/" + articleVersionKey + "/original.njk" %}
  </div>

  <div data-article-panel="copy-edited" hidden>
    <h2 class="visually-hidden">Copy-edited article</h2>
    {% include "articles/" + articleVersionKey + "/copy-edited.njk" %}
  </div>

  <div data-article-panel="compare" hidden>
    <div class="article-diff-heading" aria-hidden="true">
      <span>Original</span>
      <span>Copy-edited</span>
    </div>
    <div class="article-diff" data-article-diff aria-label="Comparison of original and copy-edited article text and captions"></div>
  </div>
</section>
{% endif %}
